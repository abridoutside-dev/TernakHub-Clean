# TernakHub environment variables
# Keep these values in Replit environment variables/secrets — never in source control.

# ─── Supabase (required) ──────────────────────────────────────────────────────
# Add as Replit Secrets (no VITE_ prefix needed for the server; Vite build reads
# the VITE_ versions automatically from Replit shared env vars).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Cloudflare R2 (required for image uploads) ───────────────────────────────
# These are server-side only — never use the VITE_ prefix for R2 variables.

# Non-sensitive — can be shared env vars
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=

# Sensitive — add as Replit Secrets
# This is a Cloudflare API Token (Bearer auth), NOT an S3 Access Key ID/Secret pair.
# Create it at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: R2 Storage — Edit (scoped to your bucket)
CLOUDFLARE_R2_API_TOKEN=

# Optional: public base URL for served objects (custom domain or r2.dev URL)
# If omitted, the service derives https://<bucket>.<account-id>.r2.dev/<key>
# (requires "Public Access" enabled on the bucket in the Cloudflare dashboard)
CLOUDFLARE_R2_PUBLIC_URL=
