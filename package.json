{
  "name": "ternakhub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "server:dev": "tsx watch server/index.ts",
    "server:prod": "NODE_ENV=production tsx server/index.ts",
    "type-check": "tsc -b --pretty false",
    "type-check:r2": "tsc -p tsconfig.r2.json --pretty false",
    "db:validate": "node --test tests/db-001a-production.contract.mjs",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5000",
    "lint": "eslint src tests eslint.config.js playwright.config.ts vite.config.ts",
    "lint:fix": "eslint src tests eslint.config.js playwright.config.ts vite.config.ts --fix",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "@types/node": "^26.1.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "tsx": "^4.23.9",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.4.3"
  }
}
