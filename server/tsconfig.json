{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["./index.ts", "./r2Client.ts", "./uploadPolicy.ts", "./supabaseAdmin.ts", "./middleware/**/*.ts", "./repositories/**/*.ts", "./routes/**/*.ts", "./utils/**/*.ts"]
}
